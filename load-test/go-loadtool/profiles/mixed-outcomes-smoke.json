{
  "schemaVersion": 1,
  "connections": {
    "centralTransfer": {
      "baseUrl": "https://localhost:8001",
      "caCert": "../../infra/certs/local/ca/ca.crt",
      "clientCertRoot": "../../infra/certs/local",
      "serverName": "localhost"
    },
    "notificationGateway": {
      "address": "localhost:9090",
      "caCert": "../../infra/certs/local/ca/ca.crt",
      "clientCertRoot": "../../infra/certs/local",
      "serverName": "localhost"
    }
  },
  "load": {
    "targetTxRate": 100,
    "warmup": "5s",
    "duration": "10s",
    "drain": "10s"
  },
  "scenarios": [
    {
      "type": "happy-path",
      "share": 0.8,
      "participants": {
        "hotPairCount": 8,
        "coldPairCount": 32,
        "hotTrafficShare": 0.8
      },
      "amount": {
        "minimum": 100,
        "maximum": 100098
      },
      "expectations": {
        "httpStatus": "2xx",
        "payerConfirmation": "required"
      }
    },
    {
      "type": "insufficient-funds",
      "share": 0.2,
      "participants": {
        "hotPairCount": 2,
        "coldPairCount": 8,
        "hotTrafficShare": 0.8
      },
      "amount": {
        "minimum": 100,
        "maximum": 100098
      },
      "expectations": {
        "httpStatus": "2xx",
        "payerConfirmation": "forbidden"
      }
    }
  ],
  "reporting": {
    "slaThresholdMs": 1000
  }
}
