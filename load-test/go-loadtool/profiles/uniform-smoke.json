{
  "schemaVersion": 1,
  "connections": {
    "centralTransfer": {
      "baseUrl": "https://localhost:8001",
      "caCert": "../../infra/certs/local/ca/ca.crt",
      "clientCertRoot": "../../infra/certs/local",
      "serverName": "localhost"
    },
    "notificationGateway": {
      "address": "localhost:9090",
      "caCert": "../../infra/certs/local/ca/ca.crt",
      "clientCertRoot": "../../infra/certs/local",
      "serverName": "localhost"
    }
  },
  "load": {
    "targetTxRate": 2000,
    "warmup": "1m",
    "duration": "1m",
    "drain": "30s"
  },
  "participants": {
    "distribution": {
      "type": "hot-cold-pairs",
      "hotPairCount": 10,
      "coldPairCount": 40,
      "hotTrafficShare": 0.8
    }
  },
  "traffic": {
    "seed": 1,
    "scenarios": [
      {
        "type": "happy-path",
        "share": 1.0,
        "amount": {
          "type": "sequential-range",
          "minimum": 100,
          "maximum": 100098
        },
        "expectations": {
          "httpStatus": "2xx",
          "payerConfirmation": "required"
        }
      }
    ]
  },
  "funding": {
    "type": "uniform",
    "balance": 1000000000,
    "resetIfExists": true
  },
  "reporting": {
    "slaThresholdMs": 1000
  }
}
