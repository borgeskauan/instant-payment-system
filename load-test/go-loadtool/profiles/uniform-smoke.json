{
  "schemaVersion": 1,
  "connections": {
    "centralTransfer": {
      "baseUrl": "https://localhost:8001",
      "caCert": "../../infra/certs/local/ca/ca.crt",
      "clientCertRoot": "../../infra/certs/local",
      "serverName": "localhost"
    },
    "notificationGateway": {
      "address": "localhost:9090",
      "caCert": "../../infra/certs/local/ca/ca.crt",
      "clientCertRoot": "../../infra/certs/local",
      "serverName": "localhost"
    }
  },
  "load": {
    "targetTxRate": 2000,
    "warmup": "1m",
    "duration": "1m",
    "drain": "30s"
  },
  "seed": 1,
  "scenarios": [
    {
      "type": "happy-path",
      "share": 1.0,
      "participants": {
        "firstPair": 1,
        "hotPairCount": 10,
        "coldPairCount": 40,
        "hotTrafficShare": 0.8
      },
      "funding": {
        "balance": 1000000000,
        "resetIfExists": true
      },
      "amount": {
        "minimum": 100,
        "maximum": 100098
      },
      "expectations": {
        "httpStatus": "2xx",
        "payerConfirmation": "required"
      }
    }
  ],
  "reporting": {
    "slaThresholdMs": 1000
  }
}
